# LW Connect credentials. Never commit the populated .env file.
LWCONNECT_USERNAME=
LWCONNECT_PASSWORD=
LWCONNECT_LOGIN_URL=https://www.lwconnect.org/login.html
LWCONNECT_HEADLESS=true
LWCONNECT_TIMEOUT_MS=30000
LWCONNECT_POLL_INTERVAL_MINUTES=720
LWCONNECT_RULES_PATH=./config/readings.json
LWCONNECT_ARTIFACT_DIR=./artifacts
LWCONNECT_SAVE_DIAGNOSTICS=false

MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=lwconnect-mqtt
MQTT_TOPIC_PREFIX=home/water/lwconnect
MQTT_DISCOVERY_PREFIX=homeassistant
MQTT_REJECT_UNAUTHORIZED=true
